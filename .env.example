# ── Environment ──────────────────────────────────────────────────────────────
# Dummy values shown. Copy to .env (never commit that file) and fill real values.

APP_ENV=local
APP_NAME=LoopClose

# Database (local SQLite default; Render injects a postgres:// URL automatically)
DATABASE_URL=sqlite:///./local.db

# AI provider — set to "fake" if you have no API key (app still boots)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=text-embedding-004

# AI tuning
AI_TIMEOUT_SECONDS=25
AI_MAX_RETRIES=1
AI_MAX_INPUT_CHARS=12000

# Retrieval (llm = Level A; vector = Level B, Unit 9)
RETRIEVER=llm

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Demo data — set to "true" on Render so the DB is seeded on first boot
SEED_DEMO_DATA=false

# Server
PORT=8000

# Injected by Render at runtime; used by /health to verify the deployed commit
RENDER_GIT_COMMIT=
GIT_SHA=
